{
  "manifest_version": 3,
  "name": "Obsidian AI Web Clipper",
  "version": "1.0.0",
  "description": "Webページの内容をAIで要約し、Obsidianへ一発保存するツール",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://openrouter.ai/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}